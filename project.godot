; Engine configuration file.
; Rune Bastion - 3D Tower Defense (Godot 4.7, Compatibility renderer for Web/Mobile)

config_version=5

[application]

config/name="Rune Bastion"
config/description="3D 판타지 타워 디펜스 - 룬 바스티온: 왕국 수호전"
config/version="1.0.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.05, 0.06, 0.1, 1)
boot_splash/show_image=false
config/icon="res://assets/ui/icon.png"

[autoload]

Game="*res://scripts/autoload/game.gd"
Audio="*res://scripts/autoload/audio.gd"
Content="*res://scripts/autoload/content.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6
window/energy_saving/keep_screen_on=true

[gui]

theme/default_font_antialiasing=1
common/snap_controls_to_pixels=true

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
driver/depth_prepass/enable.web_android=false
driver/depth_prepass/enable.web_ios=false
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.1, 1)
textures/canvas_textures/default_texture_filter=3

