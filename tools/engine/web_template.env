# Size-optimized web export template (tools/engine/build_template.sh, CI: .github/workflows/deploy-web.yml).
# Same engine version and Emscripten as the official 4.7.2 templates; only features this game never
# uses are left out. tools/engine/check_classes.py fails the build if a script or scene uses a class
# of a feature switched off here. Changing anything in this file rebuilds the template (~40 min in CI).
GODOT_REF=4.7.2-stable
EM_VERSION=4.0.11
SCONS_FLAGS="platform=web target=template_release threads=no production=yes
  disable_physics_2d=yes disable_physics_3d=yes disable_navigation_2d=yes disable_navigation_3d=yes disable_xr=yes
  module_godot_physics_2d_enabled=no module_godot_physics_3d_enabled=no module_jolt_physics_enabled=no
  module_navigation_2d_enabled=no module_navigation_3d_enabled=no module_mobile_vr_enabled=no module_webxr_enabled=no
  module_enet_enabled=no module_multiplayer_enabled=no module_webrtc_enabled=no module_websocket_enabled=no
  module_upnp_enabled=no module_jsonrpc_enabled=no module_mbedtls_enabled=no
  module_mp3_enabled=no module_theora_enabled=no module_interactive_music_enabled=no
  module_regex_enabled=no module_zip_enabled=no module_csg_enabled=no module_gridmap_enabled=no
  module_gltf_enabled=no module_fbx_enabled=no module_vhacd_enabled=no module_visual_shader_enabled=no
  module_dds_enabled=no module_ktx_enabled=no module_tinyexr_enabled=no module_hdr_enabled=no
  module_tga_enabled=no module_bmp_enabled=no module_objectdb_profiler_enabled=no"
# Text: the advanced text server (HarfBuzz + ICU) by default. TEXT_SERVER=fallback swaps in the much
# smaller fallback server, which shapes Hangul fine (precomposed syllables, space-separated words) -
# check Korean screenshots before switching.
TEXT_SERVER=advanced
